static func entries() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for item_key in BENCH.ITEMS.keys():
		var id := str(item_key)
		if not id.begins_with("tool."):
			continue
		var study_item: Dictionary = BENCH.ITEMS[id]
		result.append({
			"id": id,
			"name": str(study_item["name"]),
			"german": str(study_item["german"]),
			"kind": "Existing bench study model",
			"scene": str(study_item["scene"]),
			"cue": str(study_item["cue"]),
			"purpose": str(study_item["purpose"]),
			"source": str(study_item["source"]),
		})
	for entry: Dictionary in EXTRA:
		result.append(entry.duplicate(true))
	for entry: Dictionary in HAND_TOOLS:
		result.append(entry.duplicate(true))
	for entry: Dictionary in ROTARY_ISOLATION_TOOLS:
		result.append(entry.duplicate(true))
	for entry: Dictionary in ASSISTANT_RESTORATIVE_TOOLS:
		result.append(entry.duplicate(true))
	for entry: Dictionary in PROSTHO_ORTHO_TOOLS:
		result.append(entry.duplicate(true))
	for entry: Dictionary in PERIO_SURGERY_TOOLS:
		result.append(entry.duplicate(true))
	for entry: Dictionary in FINISHING_ACCESSORY_TOOLS:
		result.append(entry.duplicate(true))
	for entry: Dictionary in SURGICAL_IMPLANT_TOOLS:
		result.append(entry.duplicate(true))
	for entry: Dictionary in DIAGNOSTIC_IMAGING_TOOLS:
		result.append(entry.duplicate(true))
	for entry: Dictionary in LABORATORY_IMPRESSION_TOOLS:
		result.append(entry.duplicate(true))
	for entry: Dictionary in ADVANCED_ENDODONTIC_TOOLS:
		result.append(entry.duplicate(true))
	return result
